APP_ENV=development
DJANGO_SECRET_KEY=replace-with-random-secret
FIELD_ENCRYPTION_KEY=replace-with-fernet-key
POSTGRES_DB=support
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=56432
POSTGRES_USER=support_app
POSTGRES_PASSWORD=replace-with-random-app-password
POSTGRES_OWNER_PASSWORD=replace-with-random-owner-password
DEMO_PASSWORD=replace-with-random-demo-password-at-least-12-characters
REDIS_URL=redis://127.0.0.1:56379/0
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=53310
# Development only: explicit insecure scanner bypass. Never use with customer data.
DEV_SCAN_BYPASS=0
# Optional customer agent: full OpenAI-compatible chat completions URL.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# HTTPS Cloudflare deployment (set these to the actual public hostname).
# ALLOWED_HOSTS=localhost,127.0.0.1,api,web,destek.example.com
# CSRF_TRUSTED_ORIGINS=https://destek.example.com
